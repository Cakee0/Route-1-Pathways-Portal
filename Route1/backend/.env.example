# Copy to .env and fill in. Do not commit the real .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mysqlRouteOne
DB_USER=root
DB_PASSWORD=changeme
SECRET_KEY=run: python -c "import secrets; print(secrets.token_hex(32))"
# Google Sign-In: the OAuth 2.0 "Web application" client ID from Google Cloud
# Console. Must be identical to GOOGLE_CLIENT_ID in Route1/frontend/app.js.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Optional, for strict SSL cert verification against AWS RDS:
# RDS_SSL_CA=/path/to/global-bundle.pem
# Browser origins allowed to call this API (comma-separated, no trailing slash).
# Add your GitHub Pages origin here in production. localhost is always allowed.
# ALLOWED_ORIGINS=https://your-username.github.io,https://route1app.com
